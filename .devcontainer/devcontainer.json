{
  "name": "React LocalLibrary",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/mongodb:1": {}
  },
  "postCreateCommand": "npm install --prefix server",
  "forwardPorts": [3000, 5173, 27017],
  "remoteEnv": {
    "PORT": "3000"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
