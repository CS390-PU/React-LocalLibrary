{
  "name": "React LocalLibrary",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000, 27017],
  "portsAttributes": {
  "3000": {
    "label": "Express API",
    "onAutoForward": "openBrowser",
    "visibility": "public"
  },
  "5173": {
    "label": "Vite Frontend",
    "onAutoForward": "openBrowser",
    "visibility": "public"
  },
  "27017": {
    "label": "MongoDB",
    "visibility": "public"
  }
},
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
"postCreateCommand": "./start.sh"
}
